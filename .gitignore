# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Env / secrets ---
.env
.env.local
.env.*.local
# A timestamped copy taken before editing .env holds every secret .env does,
# and `.env` above does not match it. Without this line one `git add .` away
# from committing the lot.
.env.backup-*

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Node / frontend ---
node_modules/
dist/
.vite/
coverage/
.cache/

# Vue/TS compile artifacts. Vite serves .ts/.vue directly via esbuild and
# vue-tsc only typechecks (noEmit). These would otherwise shadow live sources
# in both Vite's config-discovery (.ts) and Vitest's module-resolution (.ts/.js).
containers/frontend/src/**/*.js
containers/frontend/src/**/*.d.ts
containers/frontend/vite.config.js
containers/frontend/vite.config.d.ts

# --- .NET ---
bin/
obj/
out/
*.user
*.suo
*.userosscache
*.sln.docstates
TestResults/

# --- Database / volumes ---
data/
volumes/
*.dump

# --- Docker ---
# Local-only override that compose auto-picks-up alongside docker-compose.yml.
docker-compose.override.yml
!docker-compose.override.example.yml

# --- Build artifacts ---
*.tsbuildinfo
*.tgz

# --- Frontend SPA bundle served by Caddy ---
# Generated by the `frontend` build container (cp dist -> site) on every `up`,
# not source. Keep the directory (it's the Caddy bind-mount point), ignore the
# content-hashed Vite output that would otherwise dirty the tree on each build.
/containers/caddy/site/*
!/containers/caddy/site/.gitkeep

# --- Claude Code ---
# Machine-specific permission grants; shared settings belong in .claude/settings.json
.claude/settings.local.json
# Screenshots and page captures from the Playwright MCP browser (.mcp.json);
# they can show local test data and are never source.
.playwright-mcp/
# Browser test layer (tests/browser): traces and screenshots of failed journeys.
tests/browser/test-results/
tests/browser/playwright-report/
